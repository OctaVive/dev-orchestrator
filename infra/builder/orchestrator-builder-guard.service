[Unit]
Description=Orchestrator independent build lease reconciliation
After=local-fs.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/sbin/orchestrator-provisioner -mode guard -backend linux-kvm -linux-config /var/lib/orchestrator-builder/host/backend.json -ledger /var/lib/orchestrator-builder/ledger/leases.db
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
