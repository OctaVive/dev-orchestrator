#include <tunables/global>
profile tap-runtime flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  signal (receive),
  ptrace (trace,read) peer=tap-runtime,
  deny mount,
  deny /proc/sys/** wklx,
  deny /sys/** wklx,
  deny /proc/kcore rwklx,
  deny /proc/keys rwklx,
  deny /proc/timer_list rwklx,
  deny /sys/firmware/** rwklx,
}
