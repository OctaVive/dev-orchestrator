{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "command_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "worker_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "key_id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "spec_hash": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2
        },
        "profile": {
          "const": "restricted-v1"
        },
        "policy_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "app_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "deployment_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "context_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/name"
              },
              "image": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^[a-z0-9][a-z0-9.:-]*/[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}$"
              },
              "admission_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "gid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\x00]*$"
                }
              },
              "entrypoint": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\x00]*$"
                }
              },
              "environment": {
                "$ref": "common.schema.json#/$defs/environment"
              },
              "expose": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "depends_on": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "$ref": "common.schema.json#/$defs/name"
                }
              },
              "volumes": {
                "$ref": "common.schema.json#/$defs/mounts"
              },
              "secrets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "version": {
                      "$ref": "common.schema.json#/$defs/digest"
                    },
                    "target": {
                      "type": "string",
                      "pattern": "^/run/secrets/[a-z][a-z0-9_-]{0,62}$"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "target"
                  ]
                }
              },
              "resources": {
                "$ref": "common.schema.json#/$defs/resources"
              },
              "restart_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "health": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 4096,
                      "pattern": "^[^\\x00]*$"
                    }
                  },
                  "interval_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "retries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "argv",
                  "interval_seconds",
                  "timeout_seconds",
                  "retries"
                ]
              }
            },
            "required": [
              "name",
              "image",
              "admission_id",
              "uid",
              "gid",
              "resources",
              "restart_attempts"
            ]
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "port",
            "health_path"
          ],
          "properties": {
            "service": {
              "$ref": "common.schema.json#/$defs/name"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "health_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/[A-Za-z0-9/_-]*$"
            }
          }
        }
      },
      "required": [
        "version",
        "profile",
        "policy_hash",
        "app_id",
        "deployment_id",
        "sha",
        "context_id",
        "plan_hash",
        "services",
        "ingress"
      ]
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "worker_id",
    "generation",
    "expires_at",
    "nonce",
    "key_id",
    "signature",
    "spec_hash",
    "spec"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dev-orchestrator.invalid/v1/agent-v2.schema.json",
  "title": "M08 normalized command; signature and replay authorization still required"
}
