{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dev-orchestrator.invalid/v1/agent.schema.json",
  "title": "Deploy command shape; signatures, replay and policy must be independently verified",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "command_id", "action", "app_id", "deployment_id", "worker_id", "generation", "expires_at", "nonce", "policy_hash", "key_id", "signature", "spec"],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"$ref": "common.schema.json#/$defs/id"},
    "action": {"const": "deploy"},
    "app_id": {"$ref": "common.schema.json#/$defs/id"},
    "deployment_id": {"$ref": "common.schema.json#/$defs/id"},
    "worker_id": {"$ref": "common.schema.json#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "expires_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"$ref": "common.schema.json#/$defs/digest"},
    "key_id": {"$ref": "common.schema.json#/$defs/name"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "image", "uid", "gid", "resources"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/name"},
        "image": {"type": "string", "maxLength": 512, "pattern": "^[a-z0-9][a-z0-9.:-]*/[a-z0-9]+([._/-][a-z0-9]+)*@sha256:[0-9a-f]{64}$"},
        "uid": {"type": "integer", "minimum": 1, "maximum": 65535},
        "gid": {"type": "integer", "minimum": 1, "maximum": 65535},
        "command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 4096, "pattern": "^[^\\x00]*$"}},
        "environment": {"$ref": "common.schema.json#/$defs/environment"},
        "volumes": {"$ref": "common.schema.json#/$defs/mounts"},
        "resources": {"$ref": "common.schema.json#/$defs/resources"}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "services", "ingress"],
      "properties": {
        "profile": {"const": "restricted-v1"},
        "services": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/service"}},
        "ingress": {
          "type": "object", "additionalProperties": false,
          "required": ["service", "port", "health_path"],
          "properties": {
            "service": {"$ref": "common.schema.json#/$defs/name"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "health_path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/[A-Za-z0-9/_-]*$"}
          }
        }
      }
    }
  }
}
